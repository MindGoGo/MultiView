{
  "name": "multiview",
  "productName": "MultiView",
  "version": "0.4.1",
  "description": "在一個視窗中分割顯示多個直播",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --x64",
    "icon": "node scripts/make-icon.mjs",
    "adblock:update": "node scripts/update-easylist.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts-experimental": "^7.4.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "local.multiview",
    "productName": "MultiView",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/easylist.txt",
        "to": "easylist.txt"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MultiView",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
